FROM mcr.microsoft.com/playwright:v1.50.1-noble

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY prisma ./prisma

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy application files
COPY . .

# Ensure marketing directory exists for logs/history
RUN mkdir -p marketing

# Set environment variables
ENV NODE_ENV=production

# Command to run the agent in headless mode with auto-approve
CMD ["node", "scripts/outreach_agent.js", "--headless", "--auto"]
