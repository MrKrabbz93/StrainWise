// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Strain {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   // Sativa, Indica, Hybrid
  thc         Float?
  cbd         Float?
  effects     String[]
  flavors     String[]
  description String?
  imageUrl    String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@index([effects])
}

model ConsultantSession {
  id        String   @id @default(uuid())
  userId    String?  // Optional for guest users
  persona   String   // The Guide, The Scientist, etc.
  startTime DateTime @default(now())
  endTime   DateTime?
  messages  Json[]   // Store chat history for this session
  metadata  Json?    // Any extra context

  @@index([userId])
  @@index([startTime])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g., "view_strain", "chat_message", "add_favorite"
  details   Json?
  timestamp DateTime @default(now())
  ipAddress String?  // For security/rate limiting analysis

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}


model Profile {
  id                  String   @id @default(uuid())
  username            String?  @unique
  bio                 String?
  avatar_url          String?
  base64_image        String?  // Fallback for direct image storage
  interests           String?
  is_public           Boolean  @default(false)
  updated_at          DateTime @updatedAt

  // Monetization / Subscription Fields
  stripe_customer_id  String?  @unique
  subscription_tier   String   @default("free") // 'free', 'pro', 'expert'
  subscription_status String   @default("active") // 'active', 'past_due', 'canceled'
  
  @@map("profiles") // Maps to existing Supabase 'profiles' table if it exists
}

model StrainJournal {
  id            Int      @id @default(autoincrement())
  user_id       String   
  strain_id     String
  rating        Int?
  dosage        String?
  effects       String[]
  notes         String?
  activity_tags String[]
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("strain_journals")
}

model Favorite {
  id             Int      @id @default(autoincrement())
  user_id        String
  strain_name    String
  strain_id      String
  type           String
  visual_profile String?
  created_at     DateTime @default(now())

  @@map("favorites")
}
